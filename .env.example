NODE_ENV=development
PORT=3005

# Wire these as features land (see architecture/06, 03, 08).
# Notification Service is Mongo-only (mongo.notifications collection per
# arch §2) — no Postgres schema, no DATABASE_URL.
MONGODB_URI=mongodb://localhost:27017/mis_notification?directConnection=true
REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:29092
AUTH_JWKS_URI=http://localhost:3001/.well-known/jwks.json
LOG_LEVEL=debug

# Outbound SMTP — MailDev locally (see mis-dev/docker/docker-compose.yml).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
